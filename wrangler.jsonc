{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // The Worker is the production origin for blog.cyberdudebivash.in.
  // A Cloudflare Custom Domain owns DNS/certificate lifecycle and removes any
  // dependency on the retired external origin.
  "name": "cyberdudebivash-blog",
  "main": "workers/entry.js",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./dist-public",
    "binding": "ASSETS",
    "html_handling": "none",
    // Option A (durable SOC freshness, docs/operations/SOC-RUNTIME-FEED-OPTION-A.md):
    // ONLY these three exact paths run the Worker first so the runtime feed in R2
    // (RUNTIME_FEED below) can be served without a deploy. Every other static asset
    // stays free of Worker invocations. The Worker falls open to the static asset
    // whenever the runtime object is absent, invalid or older than 6 h. Never use
    // `true` or a wildcard here: that would bill a Worker request for every asset.
    // Pinned by tests-js/runtime-feed-activation-config.test.js.
    "run_worker_first": ["/live-intel.json", "/api/intel/live.json", "/rss.xml"]
  },

  // P0: add SOC alongside the proven legacy hostname; do not redirect yet.
  "routes": [
    {
      "pattern": "blog.cyberdudebivash.in",
      "custom_domain": true
    },
    {
      "pattern": "soc.cyberdudebivash.in",
      "custom_domain": true
    }
  ],

  "rules": [
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.woff"], "fallthrough": true }
  ],

  "observability": {
    "enabled": true,
    // Bounded operational telemetry: 10% head sampling reduces paid log
    // ingestion. Do not use sampled platform logs as customer SOC evidence.
    "head_sampling_rate": 0.1
  },

  // Canonical customer/control-plane D1 database. The migration directory now
  // also contains 0008_premium_intelligence_commerce.sql; applying migrations
  // is an explicit operator step before enabling premium commerce in production.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sentinel-apex-core",
      "migrations_dir": "./migrations"
    }
  ],

  // Premium ReportX artifacts. This binding is intentionally Cloudflare-native:
  // no AWS SDK, S3 compatibility credentials, or public bucket URL is used by
  // the commerce engine. Create the bucket before deployment with an authorized
  // Cloudflare operator (`wrangler r2 bucket create sentinel-apex-premium-reports`).
  // Checkout fails closed if the bound artifact cannot be HEAD-verified against
  // the exact artifact SHA-256 pinned by ReportX human certification.
  "r2_buckets": [
    {
      "binding": "PREMIUM_REPORTS",
      "bucket_name": "sentinel-apex-premium-reports"
    },
    // Option A runtime feed: a DEDICATED, public-derived bucket (never the paid
    // artifacts above). Written only by the flag-gated publisher workflow with a
    // bucket-scoped token; read-only here. The bucket MUST exist before deploy
    // (`wrangler deploy` fails otherwise): see docs/runbooks/SOC-RUNTIME-FEED-ACTIVATION.md.
    {
      "binding": "RUNTIME_FEED",
      "bucket_name": "soc-runtime-feed"
    }
  ],

  // Sentinel APEX plan entitlement (premium reports): the blog asks the
  // existing sentinel-apex-gateway Worker's /api/auth/validate, which applies
  // the platform's own key, revocation and subscription checks. A binding to
  // an existing Worker: no new Cloudflare resource, no shared secret.
  "services": [
    {
      "binding": "SENTINEL_GATEWAY",
      "service": "sentinel-apex-gateway"
    }
  ],

  "triggers": {
    "crons": ["*/30 * * * *"]
  }

  // Real secret values remain intentionally absent.
  // Runtime secrets/vars are managed in Cloudflare; deployment credentials are GitHub secrets.
}
